{
  "name": "dicom-subtract-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"dist/*.mjs\" \"dist/*.js\" \"dist/*.css\" \"dist/*.html\" \"scripts/*.mjs\" \"tests/*.mjs\" \"package.json\" \"package-lock.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"dist/*.mjs\" \"dist/*.js\" \"dist/*.css\" \"dist/*.html\" \"scripts/*.mjs\" \"tests/*.mjs\" \"package.json\" \"package-lock.json\" \".prettierrc.json\""
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "1.2.3",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "1.2.2",
    "@cornerstonejs/codec-openjpeg": "1.3.0",
    "dicom-parser": "1.8.21",
    "fflate": "0.8.2",
    "jpeg-lossless-decoder-js": "2.1.2"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
